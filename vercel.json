{
  "version": 2,
  "builds": [
    {
      "src": "api/health.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/debug-import.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "api/health.js"
    },
    {
      "src": "/debug-import",
      "dest": "api/debug-import.js"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}
