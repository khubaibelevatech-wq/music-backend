{
  "version": 2,
  "builds": [
    {
      "src": "api/health.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "uploads/**"
    }
  },
  "routes": [
    {
      "src": "/health",
      "dest": "api/health.js"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}
